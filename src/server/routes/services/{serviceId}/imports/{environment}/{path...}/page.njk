{% extends "layouts/tabbed-page.njk" %}
{% from "folder-tree/macro.njk" import appFolderTree %}
{% from "file-list/macro.njk" import appFileList %}
{% from "file-upload/macro.njk" import appFileUpload %}

{% block beforeTabContent %}
  {{ appPageHeading({
    caption: "Imports",
    text: entity.name
  }) }}

  {% include "partials/entity/messages.njk" %}
{% endblock %}

{% block tabContent %}
  <section class="govuk-!-margin-top-6">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full" data-js="xhr-nav" >

        {% call appSplitPane() %}
          <span class="govuk-caption-l">{{environment | formatText}}</span>
          <h2 class="govuk-heading-l govuk-!-margin-bottom-2">Imports</h2>
          <p class="govuk-!-margin-bottom-6">
            Manage imported data associated with <strong>{{entity.name}}</strong>, including uploading and downloading.
          </p>

          {% block xhrContent %}

            <div class="govuk-grid-row">
              <div class="govuk-grid-column-one-quarter">
                <div data-xhr="folder-tree">
                  {{ appFolderTree({
                    tree: folderTree,
                    basePath: "/services/" + entity.name + "/imports/" + environment + "/"
                  }) }}
                </div>

                {{ appInfo({
                  html: '<h3 class="govuk-heading-m govuk-!-margin-bottom-2">Important</h3>Production data must only be loaded into the Production environment.',
                  classes: 'govuk-!-margin-top-8'
                }) }}

              </div>

              <div class="govuk-grid-column-three-quarters">

                <div data-xhr="folder-contents">
                  {{ appFileList({
                    files: folderList,
                    path: path,
                    basePath: "/services/" + entity.name + "/imports/" + environment + "/",
                    parentPath: relativePathParts.slice(0, -1).join('/') if path != '' else null,
                    actions: [
                      {
                        text: "Add sub folder",
                        href: "/services/" + entity.name + "/imports-action/" + environment + "/" + path + "?action=create"
                      }
                    ]
                  }) }}
                </div>

                <div data-xhr="file-upload">
                  {{ appFileUpload({
                    environment: environment,
                    path: path,
                    filenames: filenames,
                    csrfToken: csrfToken,
                    service: entity.name
                  }) }}
                </div>

              </div>
            </div>

          {% endblock %}

        {% endcall %}

      </div>
    </div>
  </section>
{% endblock %}

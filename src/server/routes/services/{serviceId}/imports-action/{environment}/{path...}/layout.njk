{% extends "layouts/tabbed-page.njk" %}
{% from "folder-tree/macro.njk" import appFolderTree %}
{% from "file-list/macro.njk" import appFileList %}
{% from "file-upload/macro.njk" import appFileUpload %}

{% block beforeTabContent %}
  {{ appPageHeading({
    caption: "Imports",
    text: entity.name
  }) }}

  {% include "partials/entity/messages.njk" %}
{% endblock %}

{% block tabContent %}
  <section class="govuk-!-margin-top-6">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-third-from-desktop-wide" data-js="xhr-nav" >

        {% if importStep != null %}
          {{ appStepNavigation({
            "classes":"app-step-navigation--slim govuk-!-margin-bottom-8",
            "width": 0 if importStep == 1 else 100,
            "steps":[
              {url: "/create/resources/detail", isCurrent: importStep == 1, isComplete: importStep == 2, text: "Import"},
              {isCurrent: importStep == 2, text: "Summary"}
            ]
          }) }}
        {% endif %}

        <h2 class="govuk-heading-l govuk-!-margin-bottom-2">{{ actionTitle }}</h2>
        <p class="govuk-!-margin-bottom-6">
          {{ actionDescription | safe }}
        </p>

        {% block formContent %}{% endblock %}

      </div>
    </div>
  </section>
{% endblock %}

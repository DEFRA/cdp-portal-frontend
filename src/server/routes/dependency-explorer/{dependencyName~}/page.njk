{% extends "layouts/page.njk" %}
{% from "filter-group/macro.njk" import appFilterGroup %}
{% from "combobox/macro.njk" import appCombobox %}
{% from "typeahead/macro.njk" import appTypeahead %}
{% from "./components/entity-row/macro.njk" import entityRow %}

{% block content %}
  {{ appPageHeading({
    text: "Dependency Explorer",
    intro: "View the services which are using a dependency"
  }) }}

  <form id="dependencyForm" action="" method="POST"
    data-hx-post=""
    data-hx-trigger="change"
    data-hx-target="#filtersAndResults"
    data-hx-indicator="[data-js='results-loader']"
    data-hx-push-url="true"
  >
    <input type="hidden" name="csrfToken" value="{{ csrfToken }}" />

    {% call govukFieldset() %}

    <div style="display: flex; align-items: end;">
      {{ appTypeahead({
        id: "dependencyName",
        name: "dependencyName",
        classes: "app-typeahead--medium app-typeahead--inline app-typeahead--search",
        label: {
          text: "Dependency name",
          classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
        },
        icon: appSearchIcon(),
        formGroup: {
          classes: "app-form-group--inline"
        },
        value: dependencyName,
        url: '/dependency-explorer/api/deps-search',
        loader: {
          name: "search-dependency-loader"
        },
        placeholder: "Search by dependency"
      }) }}
      {{ appLoader({ name: 'results-loader', classes: 'govuk-!-margin-bottom-2 govuk-!-margin-left-2' }) }}
    </div>

      <div class="govuk-body govuk-!-margin-top-4">
        {{ govukButton({
          classes: "app-button js-hidden",
          text: "View services"
        }) }}
      </div>

    {% endcall %}

  </form>

  {% block xhrContent %}
    <div id="filtersAndResults">
      {% call appFilterGroup({
        action: pageUrl,
        clear: {
          url: pageUrl
        },
        attributes: {
          'data-hx-action': pageUrl,
          'data-hx-method': 'get',
          'data-hx-trigger': 'change, submit halt',
          'data-hx-target': '#filtersAndResults',
          'data-hx-select': '#filtersAndResults',
          'data-hx-indicator': "[data-js='rows-loader']",
          'data-hx-push-url': 'true'
        },
        info: {
          html: appEntityDataList({
            items:  [
              {
                heading: {
                  text: 'Count'
                },
                entity: {
                  kind: 'text',
                  value: totalItems | formatNumber,
                  title: totalItems,
                  dataJs: 'rows-loader',
                  classes: 'app-loader app-loader--visiable'
                }
              }
            ]
          })
        }
      }) %}

      <div class="app-filters__item">
        {{ appCombobox({
          id: "entity",
          name: "entity",
          classes: "app-combobox--small app-combobox--inline",
          label: {
            text: "Service name",
            classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
          },
          formGroup: {
            classes: "app-form-group--inline"
          },
          value: query.entity,
          options: entityOptions
        }) }}
      </div>

      <div class="app-filters__item">
        {{ govukInput({
          id: "versionStart",
          name: "versionStart",
          classes: "app-input app-input--medium app-input--block",
          label: {
            text: "Dependency version from",
            classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
          },
          formGroup: {
            classes: "app-form-group--inline"
          },
          value: query.versionStart,
          attributes: {
            placeholder: "Start version"
          }
        }) }}
      </div>

      <div class="app-filters__item">
        {{ govukInput({
          id: "versionEnd",
          name: "versionEnd",
          classes: "app-input app-input--medium app-input--block",
          label: {
            text: "Dependency version to",
            classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
          },
          formGroup: {
            classes: "app-form-group--inline"
          },
          value: query.versionEnd,
          attributes: {
            placeholder: "End version"
          }
        }) }}
      </div>

      <div class="app-filters__item">
        {{ appCombobox({
          id: "team",
          name: "team",
          classes: "app-combobox--small app-combobox--inline",
          label: {
            text: "Team",
            classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
          },
          formGroup: {
            classes: "app-form-group--inline"
          },
          value: query.team,
          options: teamOptions
        }) }}
      </div>

      <div class="app-filters__item">
        {{ appCombobox({
          id: "environment",
          name: "environment",
          classes: "app-combobox--tiny app-combobox--inline",
          label: {
            text: "Environment",
            classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
          },
          formGroup: {
            classes: "app-form-group--inline"
          },
          value: query.environment,
          options: environmentOptions
        }) }}
      </div>

      <div class="app-filters__item">
        {{ appCombobox({
          id: "tag",
          name: "tag",
          classes: "app-combobox--tiny app-combobox--inline",
          label: {
            text: "Service tag",
            classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
          },
          formGroup: {
            classes: "app-form-group--inline"
          },
          value: query.tag,
          options: tagOptions
        }) }}
      </div>

    {% endcall %}

      <div id="results">
        {% call(params) appEntityTable(tableData) %}
          {{  entityRow({
            rowClasses: params.rowClasses,
            loopIndex: params.loopIndex,
            dependencyType: dependencyType,
            dependencyName: dependencyName,
            entity:  params.row.entity,
            entityVersion: params.row.entityVersion,
            entityStage: params.row.entityStage,
            entityTags: params.row.entityTags,
            teams: params.row.teams,
            dependencyVersion: params.row.dependencyVersion,
            envs: params.row.envs
          }) }}
        {% endcall %}
      </div>
    </div>
  {% endblock %}

{% endblock %}

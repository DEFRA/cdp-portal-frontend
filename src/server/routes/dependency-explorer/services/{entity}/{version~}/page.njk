{% extends "layouts/page.njk" %}
{% from "filter-group/macro.njk" import appFilterGroup %}
{% from "combobox/macro.njk" import appCombobox %}
{% from "typeahead/macro.njk" import appTypeahead %}
{% from "./components/dependency-row/macro.njk" import dependencyRow %}

{% block content %}
  {{ appPageHeading({
    text: entity,
    intro: 'Dependencies'
  }) }}


  <form id="versionForm" action="" method="POST"
    data-hx-post=""
    data-hx-trigger="change"
    data-hx-target="#filtersAndResults"
    data-hx-indicator="[data-js='results-loader']"
    data-hx-push-url="true"
  >
    <input type="hidden" name="csrfToken" value="{{ csrfToken }}" />

    {% call govukFieldset() %}

    <div style="display: flex; align-items: end;">

      {{ appCombobox({
        id: "versionInput",
        name: "version",
        classes: "app-combobox--medium app-combobox--inline",
        label: {
          text: "Version",
          classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
        },
        icon: appSearchIcon(),
        formGroup: {
          classes: "app-form-group--inline"
        },
        value: version,
        options: versionOptions,
        placeholder: "Search by version"
      }) }}
      {{ appLoader({ name: 'results-loader', classes: 'govuk-!-margin-bottom-2 govuk-!-margin-left-2' }) }}
    </div>

      <div class="govuk-body govuk-!-margin-top-4">
        {{ govukButton({
          classes: "app-button js-hidden",
          text: "View dependencies"
        }) }}
      </div>

    {% endcall %}

  </form>

  {% block xhrContent %}
    <div id="filtersAndResults">
      {% call appFilterGroup({
        action: pageUrl,
        clear: {
          url: pageUrl
        },
        attributes: {
          'data-hx-action': pageUrl,
          'data-hx-method': 'get',
          'data-hx-trigger': 'change, submit halt',
          'data-hx-target': '#filtersAndResults',
          'data-hx-select': '#filtersAndResults',
          'data-hx-indicator': "[data-js='rows-loader']",
          'data-hx-push-url': 'true'
        },
        info: {
          html: appEntityDataList({
            items:  [
              {
                heading: {
                  text: 'Count'
                },
                entity: {
                  kind: 'text',
                  value: totalItems | formatNumber,
                  title: totalItems,
                  dataJs: 'rows-loader',
                  classes: 'app-loader app-loader--visiable'
                }
              }
            ]
          })
        }
      }) %}

        <div class="app-filters__item">
          {{ appCombobox({
          id: "dependencyType",
          name: "dependencyType",
          classes: "app-combobox--tiny app-combobox--inline",
          label: {
            text: "Dependency type",
            classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
          },
          formGroup: {
            classes: "app-form-group--inline"
          },
          value: query.dependencyType,
          options: dependencyTypeOptions
          }) }}
        </div>

        <div class="app-filters__item">
          {{ appTypeahead({
            id: "dependencyName",
            name: "dependencyName",
            classes: "app-typeahead--medium app-typeahead--inline app-typeahead--search",
            label: {
              text: "Dependency name",
              classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
            },
            icon: appSearchIcon(),
            formGroup: {
              classes: "app-form-group--inline"
            },
            value: query.dependencyName,
            suggestionText: query.dependencyName_text,
            url: '/dependency-explorer/api/deps-search',
            suggestionClasses: "app-typeahead--leading-hint",
            placeholder: "Search by dependency"
          }) }}
        </div>


        <div class="app-filters__item">
          {{ govukInput({
            id: "dependencyVersion",
            name: "dependencyVersion",
            classes: "app-input app-input--tiny app-input--block",
            label: {
              text: "Dependency version",
              classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
            },
            formGroup: {
              classes: "app-form-group--inline"
            },
            value: query.dependencyVersion,
            attributes: {
              placeholder: "Version"
            }
          }) }}
        </div>

        <div class="app-filters__item">
          {{ appCombobox({
          id: "entityStage",
          name: "entityStage",
          classes: "app-combobox--tiny app-combobox--inline",
          label: {
            text: "Stage",
            classes: "govuk-label--s app-label--inline govuk-!-margin-bottom-1"
          },
          formGroup: {
            classes: "app-form-group--inline"
          },
          value: query.entityStage,
          options: entityStageOptions
          }) }}
        </div>

      {% endcall %}

      <div id="results">
        {% call(params) appEntityTable(tableData) %}
          {{  dependencyRow({
            rowClasses: params.rowClasses,
            loopIndex: params.loopIndex,
            entityStage: params.row.entityStage,
            dependencyName: params.row.dependencyName,
            dependencyVersion: params.row.dependencyVersion,
            dependencyType: params.row.dependencyType
          }) }}
        {% endcall %}
      </div>
    </div>
  {% endblock %}

{% endblock %}

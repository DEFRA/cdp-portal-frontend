
{% extends "layouts/page.njk" %}

{% block content %}
  {% call appSplitPane({ isWide: true }) %}

    <div class="govuk-main-wrapper app-main-wrapper">

      {{ appPageHeading({
        text: "Add users"
      }) }}

      <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half-from-desktop-wide">

          {% if users | length %}

            {# Users #}

            <h2 class="govuk-heading-l">Users</h2>

            <p class="govuk-body">
              You have added {{ users | length }}
              {{ "user" if users | length == 1 else "users" }}.
            </p>

            <table class="govuk-table">
              <caption class="govuk-visually-hidden">Users</caption>

              <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                  <th scope="col" class="govuk-visually-hidden">Name</th>
                  <th scope="col" class="govuk-visually-hidden">Email</th>
                  <th scope="col" class="govuk-visually-hidden">GitHub username</th>
                  <th scope="col" class="govuk-visually-hidden">Actions</th>
                </tr>
              </thead>

              <tbody class="govuk-table__body">
                {% for user in users %}
                  <tr class="govuk-table__row">

                    <td class="govuk-table__cell">
                      <strong>{{ user.name }}</strong>
                    </td>

                    <td class="govuk-table__cell">
                      {{ user.email }}
                    </td>

                    <td class="govuk-table__cell">
                      {% if user.github %}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          width="16"
                          height="16"
                          fill="currentColor"
                          aria-hidden="true"
                          focusable="false"
                          style="vertical-align: -0.125em"
                        >
                          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                        </svg>
                        @{{ user.github }}
                      {% else %}
                        Not linked
                      {% endif %}
                    </td>

                    <td class="govuk-table__cell govuk-!-text-align-right">
                      <form action="/admin/users/remove"
                            method="post"
                            class="govuk-!-margin-bottom-0">

                        <input type="hidden"
                               name="csrfToken"
                               value="{{ csrfToken }}"/>

                        <input type="hidden"
                               name="userId"
                               value="{{ user.userId }}"/>

                        <button type="submit"
                                class="govuk-link app-link-button">
                          Remove
                          <span class="govuk-visually-hidden">
                            {{ user.name }}
                          </span>
                        </button>

                      </form>
                    </td>

                  </tr>
                {% endfor %}
              </tbody>
            </table>

            <p class="govuk-body govuk-!-margin-bottom-0">
              <a href="/admin/users/add" class="govuk-link app-link-button">
                Add another user
              </a>
            </p>

            {# Teams #}

            <h2 class="govuk-heading-l govuk-!-margin-top-8">
              Teams
            </h2>

            {% if teams | length %}

              <p class="govuk-body">
                You have selected {{ teams | length }}
                {{ "team" if teams | length == 1 else "teams" }}
                to add to all users.
              </p>

              <table class="govuk-table">
                <caption class="govuk-visually-hidden">Teams</caption>

                <thead class="govuk-table__head">
                  <tr class="govuk-table__row">
                    <th scope="col" class="govuk-visually-hidden">Team</th>
                    <th scope="col" class="govuk-visually-hidden">Actions</th>
                  </tr>
                </thead>

                <tbody class="govuk-table__body">
                  {% for team in teams %}
                    <tr class="govuk-table__row">

                      <td class="govuk-table__cell">
                        <strong>{{ team.name }}</strong>
                      </td>

                      <td class="govuk-table__cell govuk-!-text-align-right">
                        <form action="/admin/users/remove-team"
                              method="post"
                              class="govuk-!-margin-bottom-0">

                          <input type="hidden"
                                 name="csrfToken"
                                 value="{{ csrfToken }}"/>

                          <input type="hidden"
                                 name="teamId"
                                 value="{{ team.teamId }}"/>

                          <button type="submit"
                                  class="govuk-link app-link-button">
                            Remove
                            <span class="govuk-visually-hidden">
                              {{ team.name }}
                            </span>
                          </button>

                        </form>
                      </td>

                    </tr>
                  {% endfor %}
                </tbody>
              </table>

            {% else %}

              <p class="govuk-body">
                You have selected 0 teams to add to all users.
              </p>

            {% endif %}

            <p class="govuk-body govuk-!-margin-bottom-6">
              <a href="/admin/users/teams" class="govuk-link app-link-button">
                Add teams
              </a>
            </p>

            <form action="/admin/users/create" method="post">
              <input type="hidden"
                     name="csrfToken"
                     value="{{ csrfToken }}"/>

              {{ appButton({
                text: "Create",
                loader: {
                  name: "create-user-submit-button"
                }
              }) }}
            </form>

          {% else %}

            <p class="govuk-body">
              You haven't added any users yet.
            </p>

            <a href="/admin/users/add" class="govuk-link">
              Add a user
            </a>

          {% endif %}

        </div>
      </div>

    </div>

  {% endcall %}
{% endblock %}

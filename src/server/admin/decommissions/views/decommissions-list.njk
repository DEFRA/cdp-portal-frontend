{% extends "layouts/page.njk" %}

{% block content %}
  {% call appSplitPane({ isWide: true }) %}

    {{ appPageHeading({
      text: "Decommissions",
      intro: "Decommission details for Microservices and Test suites",
      cta: {
        text: "Start decommission",
        href: routeLookup('admin/decommissions/start')
      }
    }) }}

    {% block xhrContent %}

      {% call appPolling({
        id: "decommission-list",
        enabled: shouldPoll,
        url: routeLookup("admin/decommissions"),
        every: "6s"
      }) %}

        <article>
          {{ appEntityTable(tableData) }}
        </article>

      {% endcall %}

    {% endblock %}

  {% endcall %}
{% endblock %}

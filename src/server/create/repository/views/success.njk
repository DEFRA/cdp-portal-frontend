{% extends "layouts/page.njk" %}

{% block content %}

  <div class="govuk-main-wrapper app-main-wrapper">

    {{ appPageHeading({
      caption: "Create repository",
      text: "Success",
      intro: "Your repository is being created"
    }) }}

    {% call appInfo() %}
      <p>Your new repository will shortly be available at {{ repositoryLink | safe }}</p>
    {% endcall %}
  </div>

{% endblock %}

{% from "icons/tick-icon/macro.njk" import appTickIcon %}

{% set suggestions = params.suggestions if params.suggestions and params.suggestions.length != 0 else [{ text: ' - - no results - -', value: '' }] %}

<ul
  class="app-typeahead__suggestions{% if params.suggestionsContainer.classes %} {{ params.suggestionsContainer.classes }}{% endif %}{{ ' app-typeahead__suggestions--show' if suggestions.length != 0 }}"
  id="app-typeahead-{{ params.inputName }}-suggestions"
  aria-labelledby="{{ params.inputName }}-label"
  aria-expanded="{{'false' if suggestions.length == 0 else 'true'}}"
  role="listbox"
  data-testid="app-autocomplete-suggestions"
>
  {% for suggestion in suggestions %}
    <li
      class="app-typeahead__suggestion{% if suggestion.disabled %} app-typeahead__suggestion--disabled{% endif %}"
      role="option"
      tabindex="-1"
      id="app-typeahead-{{ params.id }}-suggestion-{{ loop.index }}"
      aria-posinset="{{ loop.index }}"
      aria-setsize="{{ suggestions.length }}"
      aria-selected="{{'true' if suggestion.value == params.value else 'false'}}"
    >
      <label class="app-suggestion__value">
        <input
          type="radio"
          name="app-typeahead-{{ params.id }}-option"
          value="{{ suggestion.value }}"
          class="app-typeahead__option"
        />
        {% if params.suggestionText %}
          {{ suggestion.text | replaceIgnoreCase(params.suggestionText, '<strong>$&</strong>') | safe }}
        {% else %}
          {{ suggestion.text }}
        {% endif %}
      </label>

      {% if params.partial %}
        {% include params.partial %}
      {% else %}
        {% if suggestion.hint %}
          <span class="app-suggestion__hint">{{ suggestion.hint }}</span>
        {% endif %}

        <span class="app-suggestion__action">
          {% if suggestion.value and suggestion.value == params.value %}
            {{ appTickIcon({
              classes: 'app-icon--tiny'
            }) }}
          {% endif %}
        </span>
      {% endif %}
    </li>
  {% endfor %}
</ul>

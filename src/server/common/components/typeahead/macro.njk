{% from "govuk/components/select/macro.njk" import govukSelect %}

{% macro appTypeahead(params) %}
  <app-typeahead
    data-id="{{ params.id }}"
    data-name="{{ params.name }}"
    data-value="{{ params.value }}"
    data-classes="{{ params.classes }}"
    data-label-text="{{ params.label.text }}"
    data-label-classes="{{ params.label.classes }}"
    data-hint-text="{{ params.hint.text }}"
    data-hint-html="{{ params.hint.html }}"
    data-formgroup-classes="{{ params.formGroup.classes }}"
    data-icon="{{ params.icon | replace("\"", "&quot;") | safe }}"
  >
  {%- include "./template.njk" -%}
  </app-typeahead>
{% endmacro %}

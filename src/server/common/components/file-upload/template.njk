{% from "./upload-form/macro.njk" import uploadForm %}
{% from "./upload-progress/macro.njk" import uploadProgress %}


{% if params.uploads and params.uploads.length != 0 %}
  {{ uploadProgress({
    uploads: params.uploads,
    showDone: params.showDone,
    isUploading: params.isUploading
  }) }}
{% else %}
  {{ uploadForm({
    error: params.error,
    path: params.path,
    csrfToken: params.csrfToken
  }) }}
{% endif %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "tag/macro.njk" import appTag %}

{% if params.status == 'complete' %}
  {{ appTag({ text: 'Complete', classes: "govuk-tag--green" }) }}
{% elseif params.status == 'cancelled' %}
  {{ govukButton({ text: 'Restart', classes: 'app-button--small govuk-!-margin-bottom-0' }) }}
{% elseif params.status == 'failed' %}
  {{ appTag({ text: 'Failed', classes: "govuk-tag--red" }) }} {# TODO: Make a restart button? #}
{% else %}
  {{ govukButton({ text: 'Cancel', classes: 'app-button--small govuk-button--warning govuk-!-margin-bottom-0' }) }}
{% endif %}

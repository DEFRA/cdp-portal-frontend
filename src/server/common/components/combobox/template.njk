
{% from "govuk/components/hint/macro.njk" import govukHint %}
{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}

{% from "icons/chevron-icon/macro.njk" import appChevronIcon %}
{% from "icons/cancel-icon/macro.njk" import appCancelIcon %}
{% from "loader/macro.njk" import appLoader %}

{% set options = params.options if params.options else [] %}
{% set suggestions = params.suggestions if params.suggestions else [] %}

{% set currentOption = options | find({ value: params.value }) %}
{% set currentOptionText = currentOption.text if currentOption and currentOption.value != '' else '' %}
{% set suggestionText = params.suggestionText if params.suggestionText else currentOptionText %}

{% set attributes = params.attributes if params.attributes else {} %}

<div
  id="app-combobox-{{ params.id }}"
  class="govuk-form-group app-form-group{% if params.formGroup.classes %} {{ params.formGroup.classes }}{% endif %}{% if params.errorMessage.text %}govuk-form-group--error{% endif %}"
  data-js="app-form-group" data-testid="app-autocomplete-group"
>
  <label
    class="govuk-label{% if params.label.classes %} {{ params.label.classes }}{% endif %}"
    id="{{ params.id }}-label"
    for="{{ params.id }}"
    data-testid="app-autocomplete-label"
  >
    {{ params.label.text }}
  </label>

  {% if params.hint.text or params.hint.html %}
    {{ govukHint({
      text: params.hint.text if params.hint.text,
      html: params.hint.html if params.hint.html,
      classes: "app-hint",
      attributes: {
        "data-testid": "app-autocomplete-hint"
      }
    }) }}
  {% endif %}

  {% if params.errorMessage.text %}
    {{ govukErrorMessage({
      id: params.id + "-error",
      classes: "govuk-!-margin-bottom-1 app-error-message",
      attributes: {
        "data-js": "app-error",
        "tabindex": "-1"
      },
      text: params.errorMessage.text
    }) }}
  {% endif %}

  {% set classes = ["app-combobox", params.classes if params.classes, "app-combobox--with-icon" if params.icon] | join(" ") | trim %}

  <div class="{{ classes }}"
       data-testid="app-autocomplete"
    {% if params.loader.name %} data-loader="{{ params.loader.name }}"{% endif %}
  >
    <div class="app-combobox__control">
      {% if params.icon %}
        {{ params.icon | safe }}
      {% endif %}


      <select
        {% for key, value in attributes %}{{ key }}="{{ value }}" {% endfor %}
        {% if params.value != '' and params.value != undefined %}
          name="{{ params.name }}"
        {% endif %}
        id="{{ params.id }}"
        class="govuk-select app-select js-hidden{{ ' govuk-select--error' if params.errorMessage.text }}"
        data-testid="app-progressive-input"
      >
        <option value="" {% if params.value == '' or params.value == undefined %}selected="selected"{% endif %}>- - select - -</option>
        {% for option in options %}
          <option
            value="{{ option.value }}"
            {% if params.value == option.value %}selected="selected"{% endif %}
            {% if option.hint %}data-hint="{{ option.hint }}"{% endif %}
          >
            {{ option.text }}
          </option>
        {% endfor %}
      </select>


      <input
        {% for key, value in attributes %}{{ key }}="{{ value }}" {% endfor %}
        id="app-combobox-{{ params.id }}-input"
        type="text"
        value="{{ suggestionText }}"
        class="govuk-input app-combobox__input js-visible{% if suggestions.length != 0 %} app-combobox__focused{% endif %}"
        placeholder="{{ params.placeholder if params.placeholder else ' - - select - - ' }}"
        autocapitalize="none"
        combobox="off"
        role="combobox"
        aria-controls="app-combobox-{{ params.id }}-suggestions"
        aria-combobox="list"
        aria-expanded="false"
        data-1p-ignore
        data-lpignore="true"
        autocomplete="off"
      />


      <button
        id="app-combobox-{{ params.id }}-chevron-button"
        class="app-combobox__chevron-button js-visible{{ ' app-combobox__chevron-button--open' if suggestions.length != 0 }}"
        type="button"
        tabindex="-1"
        aria-owns="app-combobox-{{ params.id }}-suggestions"
        aria-label="{{'Hide' if suggestions.length != 0 else 'Show'}}"
        data-testid="app-chevron-button"
      >
        {{ appChevronIcon() }}
      </button>

      <button
        id="app-combobox-{{ params.id }}-clear-button"
        class="app-combobox__clear-button{{ ' app-combobox__clear-button--show' if suggestionText != '' and suggestionText != undefined }}"
        type="button"
        tabindex="-1"
        data-testid="app-autocomplete-clear-button"
      >
        {{ appCancelIcon({ description: "Clear" }) }}
      </button>

      {% if params.loader.name %}
        {{ appLoader({ name: params.loader.name }) }}
      {% endif %}
    </div>

    <ul
      class="app-combobox__suggestions{% if params.suggestionsContainer.classes %} {{ params.suggestionsContainer.classes }}{% endif %}{{ ' app-combobox__suggestions--show' if suggestions.length != 0 }}"
      id="app-combobox-{{ params.id }}-suggestions"
      aria-labelledby="{{ params.id }}-label"
      aria-expanded="{{'false' if suggestions.length == 0 else 'true'}}"
      role="listbox"
      data-testid="app-autocomplete-suggestions"
    >
      {%- include "./suggestions.njk" -%}
    </ul>
  </div>
</div>

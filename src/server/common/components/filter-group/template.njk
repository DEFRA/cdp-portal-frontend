{% from "govuk/components/button/macro.njk" import govukButton %}

{% set classes = [ "app-filter-group-form", params.classes if params.classes ] | join(" ") | trim %}
{% set method = params.method | default("get") %}

<form action="{{ params.action }}" method="{{ method }}" class="{{ classes }}"
  data-hx-action="{{ params.action }}"
  data-hx-method="{{ method }}"
  data-hx-trigger="change, submit halt"
  data-hx-target="#app-filter-group-filters"
  data-hx-select="#app-filter-group-filters"
  {% if params.loader %} data-hx-indicator="[data-js='{{ params.loader }}']" {% endif %}
  data-hx-push-url="true"
  data-testid="app-filters-form"
>
  <fieldset class="govuk-fieldset {%- if params.fieldset.classes %} {{ params.fieldset.classes }}{% endif %}">
    <div id="app-filter-group-filters" class="app-filter-group">
      {{ caller() }}

      <p class="govuk-body-m govuk-!-margin-bottom-0 app-filter-group__clear-all">
        <a href="{{ params.clear.url }}"
           class="govuk-link govuk-link--text-colour"
           data-testid="app-filters-clear-all">
          Clear all
        </a>
      </p>

      <div class="app-filter-group__info" data-testid="app-filter-group-info">
        {% if params.info.html %}
          {{ params.info.html | safe }}
        {% endif %}
      </div>
    </div>

    {% for key, value in params.hiddenInputs %}
      <input type="hidden" name="{{ key }}" value="{{ value }}" data-testid="app-filters-hidden-input-{{ key }}">
    {% endfor %}

    {{ govukButton({
      classes: "app-button app-button--secondary js-hidden govuk-!-margin-top-2",
      text: "Search",
      attributes: {
        "data-testid": "app-filters-submit-button"
      }
    }) }}
  </fieldset>
</form>

{% from "govuk/components/button/macro.njk" import govukButton %}

{% set classes = [ "app-filter-group-form", params.classes if params.classes ] | join(" ") | trim %}
{% set method = params.method | default("get") %}

<form action="{{ params.action }}" method="{{ method }}" class="{{ classes }}"
      data-testid="app-filter-group-form"{% if params.loader %} data-loader-name="{{ params.loader }}" {% endif %}>
  <fieldset class="govuk-fieldset {%- if params.fieldset.classes %} {{ params.fieldset.classes }}{% endif %}">
    <div class="app-filter-group">
      {{ caller() }}

      <p class="govuk-body-m govuk-!-margin-bottom-0 app-filter-group__clear-all">
        <a href="{{ params.clear.url }}"
           class="govuk-link govuk-link--text-colour"
           data-testid="app-filter-group-clear-all"
           data-clear-all="clearFilters">
          Clear all
        </a>
      </p>

      <div class="app-filter-group__info" data-testid="app-filter-group-info">
        {% if params.info.html %}
          {{ params.info.html | safe }}
        {% endif %}
      </div>
    </div>

    {% for key, value in params.hiddenInputs %}
      <input type="hidden" name="{{ key }}" value="{{ value }}" data-testid="app-filter-group-hidden-input-{{ key }}">
    {% endfor %}

    {{ govukButton({
      classes: "app-button app-button--secondary js-hidden govuk-!-margin-top-2",
      text: "Search",
      attributes: {
        "data-testid": "app-filter-group-submit-button"
      }
    }) }}
  </fieldset>
</form>

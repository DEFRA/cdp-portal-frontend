{% extends "layouts/page.njk" %}

{% block header %}
  {{ appServiceHeader({
    serviceName: appServiceName,
    serviceUrl: "/",
    loginText: "Sign out" if isAuthenticated else "Sign in",
    loginUrl: ("/logout" if isAuthenticated else "/login"),
    isSensitiveEnvironment: true if environment == "prod" else false
  }) }}
{% endblock %}

{% set bodyClasses = "app-tool-page" + (" app-terminal-background" if isTerminalTool else "") %}

{# Override container so the iframe is not inset by .govuk-width-container #}
{% block container %}
  <main id="main-content" class="govuk-body govuk-!-margin-0 app-tool-page__main">
    <iframe
      class="app-iframe app-iframe--terminal"
      title="{{ 'Terminal' if isTerminalTool else 'Tool' }} {{ serviceId }} - {{ environment }}"
      scrolling="no"
      src="{{ terminalProxyUrl }}">
    </iframe>
  </main>
{% endblock %}

{% block footer %}{% endblock %}
